HISTORICAL_EXEMPT = ("docs/brainstorms/", "docs/INTEGRATION-rev4-arc42.md")


def _is_exempt(rel):
    return any(rel == p or rel.startswith(p) for p in HISTORICAL_EXEMPT)


def git_out(args):
    try:
        r = subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True)
    except OSError:
        return None
    return r.stdout if r.returncode == 0 else None


def head_file(rel):
    return git_out(["show", f"HEAD:{rel}"])


def index_pins():
    out = git_out(["ls-files", "-s", "--", "base-web", "rust-api"]) or ""
    pins = {"web": None, "api": None}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[0] == "160000":
            pins[{"base-web": "web", "rust-api": "api"}.get(parts[3], "")] = parts[1]
    pins.pop("", None)
    return {"web": pins.get("web"), "api": pins.get("api")}


def tracked_files():
    return [l for l in (git_out(["ls-files"]) or "").splitlines() if l]


def constitution_version(root):
    text = _read(root, ".specify/memory/constitution.md")
    if text is None:
        return None
    m = re.search(r"\*\*Version\*\*[:\s]*v?(\d+\.\d+\.\d+)", text)
    return m.group(1) if m else None


def load_adrs(root):
    d = os.path.join(root, ADR_DIR)
    if not os.path.isdir(d):
        return {}
    return {n: _read(root, f"{ADR_DIR}/{n}")
            for n in sorted(os.listdir(d)) if n.endswith(".md")}


def load_head_adrs():
    out = git_out(["ls-tree", "--name-only", "HEAD", f"{ADR_DIR}/"]) or ""
    head = {}
    for path in out.splitlines():
        name = os.path.basename(path)
        if name.endswith(".md"):
            t = head_file(path)
            if t is not None:
                head[name] = t
    return head


def lessons_paths(root):
    ops = os.path.join(root, "docs/ops")
    vols = (sorted(n for n in os.listdir(ops)
                   if n.startswith("LESSONS-") and n.endswith(".md"))
            if os.path.isdir(ops) else [])
    return ["docs/ops/LESSONS.md"] + [f"docs/ops/{v}" for v in vols]


