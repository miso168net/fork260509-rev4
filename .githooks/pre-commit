#!/bin/sh
# rev4 pre-commit：docs-sync check（L1 生成一致）＋lint（L3～L19）
# 被擋時：錯誤訊息附去處；同回合修復後重試。--no-verify 只延後、狀態型檢查不消失。
python3 tools/docs-sync.py check || exit 1
python3 tools/docs-sync.py lint || exit 1
# fork-delta 原行 紀律（憲法 §III L114）：base-web gitlink 變動（pin bump）時、機器比對 base-web vs
# example 上游、修改型缺 `原行:` 即擋——不靠人工 review。fork 源倉須在 example 分支（lint 首步斷言）。
if git diff --cached --name-only | grep -qx 'base-web'; then
  python3 tools/fork-delta-lint.py || exit 1
fi
# 守門工具自測條件觸發（FR-015／data-model §8）：staged 含某工具本體才跑該支、平時零開銷；
# fork-delta-lint 無 test 介面＝直跑一次（self-test 內建），與上方 pin bump 條件同時中則
# 各跑一次、冪等無害。
staged=$(git diff --cached --name-only)
for t in docs-sync schema-gate wire-schema; do
  if echo "$staged" | grep -qxF "tools/$t.py"; then
    python3 "tools/$t.py" test || exit 1
  fi
done
if echo "$staged" | grep -qxF 'tools/fork-delta-lint.py'; then
  python3 tools/fork-delta-lint.py || exit 1
fi
