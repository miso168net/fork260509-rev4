#!/bin/sh
# rev4 外層 pre-push — 機密掃描第二層（019 scan-gates §S3）：攔「pre-commit 被 --no-verify
# 繞過後尚未離開本機」的 commit；範圍＝本次 push 的 commit 範圍（推導見 lib/scan-range.sh）。
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOK_DIR/lib/scan-range.sh"
SCAN_CONFIG="$HOOK_DIR/../.gitleaks.toml"
scan_push_ranges || exit 1
